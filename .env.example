# 复制成 .env 后按需修改。所有项都可留空，留空即用默认值。

# 数据库。默认 SQLite 文件，部署时换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/zhongkou
DATABASE_URL=sqlite:///./zhongkou.db

# 允许跨域的前端地址，多个用逗号分隔。前后端同域部署时写 *
CORS_ORIGINS=*

# 高德开放平台 Key。留空则通行时间走后内置估算（不联网、不消耗配额）
AMAP_KEY=

# 推荐候选池大小。越大越慢，24 在深圳这套数据上已经够用
POOL_SIZE=24
